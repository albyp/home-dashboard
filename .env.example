# Secrets for dashboard.yaml (${VAR} values). Keep this file chmod 600.

# Login (set with ./set-password.sh, not by hand)
# DASHBOARD_PASSWORD_HASH=
# KIOSK_PASSWORD_HASH=
# SESSION_SECRET=

# HTTPS address from `tailscale serve`; old :3001 links redirect here
PUBLIC_URL=https://tiny.<tailnet>.ts.net
TAILNET=<tailnet>.ts.net

# Home Assistant long-lived token
HA_TOKEN=

# App API keys (read-only use; only GET requests are sent)
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
SEERR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
TANDOOR_TOKEN=
ADGUARD_USER=
ADGUARD_PASSWORD=
# Optional: raises GitHub's rate limit for the Repos panel
GITHUB_TOKEN=

# Google Calendar + Tasks for the kiosk (see README: Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_FAMILY_CALENDAR_ID=
GOOGLE_TASKS_FAMILY=
GOOGLE_TASKS_SHOPPING=

# Weather (Open-Meteo, no key)
HOME_LAT=
HOME_LON=

# Paths on the host
# SYNCTHING_CONFIG_DIR=/home/alby/.local/state/syncthing
# REPOS_DIR=/home/alby/LocalGit
